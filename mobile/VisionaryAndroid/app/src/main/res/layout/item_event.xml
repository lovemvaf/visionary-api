<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvEventTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tiêu đề sự kiện"
            android:textColor="@color/primary_navy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEventStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Published"
            android:textColor="@color/visionary_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@color/surface_light" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEventDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Mô tả sự kiện ngắn gọn..."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/tvEventInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="📍 Hội trường Edison • 🕒 28/10/2026 • 👥 45/60"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnQrCode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Mã QR"
            android:textSize="11sp"
            android:backgroundTint="@color/teal_accent"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Đăng ký tham gia"
            android:textSize="11sp"
            android:backgroundTint="@color/visionary_blue"
            android:textColor="@color/white"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</LinearLayout>
