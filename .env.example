# VISIONARY ECOSYSTEM – ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or configure in Vercel / Render / Cloud Container
# IMPORTANT: DO NOT commit your actual .env file or real secrets to Git.

# ==========================================
# 1. FRONTEND CONFIGURATION (Next.js 14)
# ==========================================
# Backend API Base URL (used by server-side BFF route handlers)
API_BASE_URL=http://localhost:5000

# Public Client-side URL (optional fallback for direct client calls)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Application Name
NEXT_PUBLIC_APP_NAME=VISIONARY

# Google OAuth 2.0 Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ==========================================
# 2. BACKEND CONFIGURATION (ASP.NET Core 8)
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000

# Database Connection: SQLite (Development) or PostgreSQL (Production)
# For Local Development:
ConnectionStrings__DefaultConnection=Data Source=visionary.db
# For Production PostgreSQL / Supabase (Set in Cloud Host Environment Variables):
# ConnectionStrings__DefaultConnection=Host=your_db_host;Port=5432;Database=your_db;Username=your_user;Password=your_password;SSL Mode=Require;Trust Server Certificate=true

# JWT Configuration (Minimum 32 characters, MUST be overridden in Production)
Jwt__Key=YOUR_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS
Jwt__Issuer=VisionaryApi
Jwt__Audience=VisionaryClients
Jwt__ExpiryMinutes=1440

# Seed Admin Password (Optional override for initial test admin credentials)
# ADMIN_SEED_PASSWORD=

# Optional External Integrations
Authentication__Google__ClientId=
Upstash__Redis__RestUrl=
Upstash__Redis__RestToken=
Email__ApiKey=
